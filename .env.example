# PORT applies to dev only; production always listens on port 80
PORT=3002
DATABASE_PATH=./data/notes.db
HIDDEN_NOTES_PIN=1234
# mDNS: production advertises as notes.local (MDNS_HOST), anything else as notesdev.local
NODE_ENV=development
# Hostname announced over mDNS in production
MDNS_HOST=notes.local